#: src/ubuntu_start.py:25
msgid "Sound and microphones"
msgstr ""

#: src/ubuntu_start.py:26
msgid "Choose the right devices"
msgstr ""

#: src/ubuntu_start.py:26
msgid ""
"Open Sound Settings and select the speakers or headphones you want to use."
msgstr ""

#: src/ubuntu_start.py:27
msgid "Check the volume"
msgstr ""

#: src/ubuntu_start.py:27
msgid ""
"Make sure output volume is up and the device is not muted. Try another app "
"or audio file."
msgstr ""

#: src/ubuntu_start.py:28
msgid "Check the microphone"
msgstr ""

#: src/ubuntu_start.py:28
msgid ""
"Speak and watch the input level in Sound Settings. Check the app’s "
"microphone permission if only one app is affected."
msgstr ""

#: src/ubuntu_start.py:30
msgid "Battery and charging"
msgstr ""

#: src/ubuntu_start.py:31
msgid "Check the power adapter"
msgstr ""

#: src/ubuntu_start.py:31
msgid ""
"Connect the adapter securely at both ends and try a working outlet. Stop "
"using a cable or adapter that is damaged or unusually hot."
msgstr ""

#: src/ubuntu_start.py:32
msgid "Check the charging status"
msgstr ""

#: src/ubuntu_start.py:32
msgid ""
"Review the charge level and charging state on the Network and hardware page. "
"If it is not charging, check the power connection and Power Settings."
msgstr ""

#: src/ubuntu_start.py:33
msgid "Check for battery wear"
msgstr ""

#: src/ubuntu_start.py:33
msgid ""
"If the estimated capacity is much lower than the design capacity, consult "
"the laptop manufacturer’s support information about battery service."
msgstr ""

#: src/ubuntu_start.py:35
msgid "Bluetooth"
msgstr ""

#: src/ubuntu_start.py:36
msgid "Check power and charge"
msgstr ""

#: src/ubuntu_start.py:36
msgid "Make sure Bluetooth is enabled and the device has enough charge."
msgstr ""

#: src/ubuntu_start.py:37
msgid "Turn on pairing mode"
msgstr ""

#: src/ubuntu_start.py:37
msgid "Keep the device nearby and follow its instructions for pairing mode."
msgstr ""

#: src/ubuntu_start.py:38
msgid "Try pairing again"
msgstr ""

#: src/ubuntu_start.py:38
msgid ""
"If an old pairing is listed, remove it in Settings, then pair the device "
"again."
msgstr ""

#: src/ubuntu_start.py:40
msgid "Printers"
msgstr ""

#: src/ubuntu_start.py:41
msgid "Check the printer"
msgstr ""

#: src/ubuntu_start.py:41
msgid ""
"Make sure it is powered on and has paper, ink or toner, and no paper jam."
msgstr ""

#: src/ubuntu_start.py:42 src/ubuntu_start.py:52 src/ubuntu_start.py:85
#: src/ubuntu_start.py:90
msgid "Check the connection"
msgstr ""

#: src/ubuntu_start.py:42
msgid ""
"For a network printer, confirm it is on the same network as this computer. "
"For USB, reconnect the cable."
msgstr ""

#: src/ubuntu_start.py:43 src/ubuntu_start.py:94
msgid "Add the printer"
msgstr ""

#: src/ubuntu_start.py:43
msgid "Open Printer Settings, add the printer and send a test page."
msgstr ""

#: src/ubuntu_start.py:44
msgid "Check for a model-specific driver"
msgstr ""

#: src/ubuntu_start.py:44
msgid ""
"If printing still fails, consult Ubuntu’s documentation or the printer "
"manufacturer before installing extra software."
msgstr ""

#: src/ubuntu_start.py:46
msgid "Displays and graphics"
msgstr ""

#: src/ubuntu_start.py:47
msgid "Check power and cables"
msgstr ""

#: src/ubuntu_start.py:47
msgid ""
"Make sure the display is on, the cable is connected and the correct input is "
"selected."
msgstr ""

#: src/ubuntu_start.py:48
msgid "Open Display Settings"
msgstr ""

#: src/ubuntu_start.py:48
msgid ""
"Check whether Ubuntu detects the display. Try a supported resolution and "
"refresh rate."
msgstr ""

#: src/ubuntu_start.py:49
msgid "Review graphics drivers"
msgstr ""

#: src/ubuntu_start.py:49
msgid ""
"If graphics are unstable or a feature is missing, review the drivers offered "
"by Ubuntu before changing anything."
msgstr ""

#: src/ubuntu_start.py:51
msgid "Keyboards"
msgstr ""

#: src/ubuntu_start.py:52
msgid ""
"For a wired keyboard, reconnect the cable. For a wireless keyboard, check "
"its charge or batteries, power switch and USB receiver."
msgstr ""

#: src/ubuntu_start.py:53
msgid "Check the keyboard layout"
msgstr ""

#: src/ubuntu_start.py:53
msgid ""
"Open Keyboard Settings and select the layout you intend to use. Test the "
"keys in another app to see whether the problem is app-specific."
msgstr ""

#: src/ubuntu_start.py:54
msgid "Try another port or keyboard"
msgstr ""

#: src/ubuntu_start.py:54
msgid ""
"For a USB keyboard, try another port. If available, connect another keyboard "
"to help identify whether the problem is with the keyboard or computer."
msgstr ""

#: src/ubuntu_start.py:56
msgid "Touchpads"
msgstr ""

#: src/ubuntu_start.py:57
msgid "Make sure the touchpad is enabled"
msgstr ""

#: src/ubuntu_start.py:57
msgid ""
"Open Mouse & Touchpad Settings and check that the touchpad is switched on. "
"Some laptops also have a keyboard shortcut that turns it off."
msgstr ""

#: src/ubuntu_start.py:58
msgid "Check the surface and pointer speed"
msgstr ""

#: src/ubuntu_start.py:58
msgid ""
"Keep the touchpad clean and dry. Adjust pointer speed in Settings, then test "
"basic movement before trying gestures."
msgstr ""

#: src/ubuntu_start.py:59
msgid "Compare with an external mouse"
msgstr ""

#: src/ubuntu_start.py:59
msgid ""
"If a mouse works but the touchpad does not, check for Ubuntu updates and "
"consult the laptop support information before changing drivers."
msgstr ""

#: src/ubuntu_start.py:61 src/ubuntu_start.py:639
msgid "Wi-Fi"
msgstr ""

#: src/ubuntu_start.py:62
msgid "Check Wi-Fi and airplane mode"
msgstr ""

#: src/ubuntu_start.py:62
msgid ""
"Turn airplane mode off and make sure Wi-Fi is enabled in Quick Settings."
msgstr ""

#: src/ubuntu_start.py:63
msgid "Check the network"
msgstr ""

#: src/ubuntu_start.py:63
msgid ""
"See whether another device can connect. If none can, restart the router and "
"check its internet connection."
msgstr ""

#: src/ubuntu_start.py:64
msgid "Reconnect to the network"
msgstr ""

#: src/ubuntu_start.py:64
msgid ""
"Forget the network in Wi-Fi Settings, then connect again and carefully enter "
"the password."
msgstr ""

#: src/ubuntu_start.py:65
msgid "If only this computer has trouble"
msgstr ""

#: src/ubuntu_start.py:65
msgid ""
"Install available Ubuntu updates. Check the computer or Wi-Fi adapter "
"support information before installing a driver."
msgstr ""

#: src/ubuntu_start.py:67
msgid "Camera"
msgstr ""

#: src/ubuntu_start.py:68
msgid "Check the camera"
msgstr ""

#: src/ubuntu_start.py:68
msgid ""
"Open its privacy shutter or switch, reconnect it if external and make sure "
"its indicator light turns on."
msgstr ""

#: src/ubuntu_start.py:69
msgid "Check app permissions"
msgstr ""

#: src/ubuntu_start.py:69
msgid ""
"Review camera access in Privacy Settings. A managed work or school computer "
"may restrict access."
msgstr ""

#: src/ubuntu_start.py:70
msgid "Close other camera apps"
msgstr ""

#: src/ubuntu_start.py:70
msgid ""
"Quit video calls and other apps that may already be using the camera, then "
"try again."
msgstr ""

#: src/ubuntu_start.py:72
msgid "Wired network"
msgstr ""

#: src/ubuntu_start.py:73
msgid "Check the Ethernet cable"
msgstr ""

#: src/ubuntu_start.py:73
msgid ""
"Connect the cable firmly to the computer and to a router, switch or wall "
"socket. Look for a link light near the port."
msgstr ""

#: src/ubuntu_start.py:74
msgid "Wait for a connection"
msgstr ""

#: src/ubuntu_start.py:74
msgid ""
"Ubuntu normally configures a wired connection automatically. Give it a few "
"seconds and check the network menu."
msgstr ""

#: src/ubuntu_start.py:75
msgid "Check Network Settings"
msgstr ""

#: src/ubuntu_start.py:75
msgid "Open Network Settings and confirm that the wired connection is enabled."
msgstr ""

#: src/ubuntu_start.py:76
msgid "Try another port or cable"
msgstr ""

#: src/ubuntu_start.py:76
msgid ""
"If there is still no link, try a different cable or router port. Ask your "
"network administrator before entering manual IP settings."
msgstr ""

#: src/ubuntu_start.py:81
msgid "Connect to Wi-Fi"
msgstr ""

#: src/ubuntu_start.py:81
msgid "Open Wi-Fi Settings"
msgstr ""

#: src/ubuntu_start.py:82 src/ubuntu_start.py:722
msgid "Open Quick Settings"
msgstr ""

#: src/ubuntu_start.py:82
msgid ""
"Select the system menu at the top-right of the screen, then open the Wi-Fi "
"section."
msgstr ""

#: src/ubuntu_start.py:83
msgid "Choose a network"
msgstr ""

#: src/ubuntu_start.py:83
msgid ""
"Select the network name you recognize. Ask its owner if you are not sure "
"which network to use."
msgstr ""

#: src/ubuntu_start.py:84
msgid "Enter the password"
msgstr ""

#: src/ubuntu_start.py:84
msgid ""
"Type the network password when Ubuntu asks, then select Connect. Never share "
"the password in a support request."
msgstr ""

#: src/ubuntu_start.py:85
msgid ""
"Wait for the Wi-Fi icon to settle. If it disconnects, move closer to the "
"router and check the password."
msgstr ""

#: src/ubuntu_start.py:87
msgid "Connect with an Ethernet cable"
msgstr ""

#: src/ubuntu_start.py:87
msgid "Open Network Settings"
msgstr ""

#: src/ubuntu_start.py:88
msgid "Connect the cable"
msgstr ""

#: src/ubuntu_start.py:88
msgid ""
"Plug one end into the computer and the other into a router, switch or active "
"wall socket."
msgstr ""

#: src/ubuntu_start.py:89
msgid "Wait for Ubuntu"
msgstr ""

#: src/ubuntu_start.py:89
msgid ""
"A wired connection is usually configured automatically. The network menu "
"shows when it is ready."
msgstr ""

#: src/ubuntu_start.py:90
msgid ""
"Open Network Settings and make sure the Wired switch is on. If there is no "
"link light, try another port or cable."
msgstr ""

#: src/ubuntu_start.py:92
msgid "Add a printer"
msgstr ""

#: src/ubuntu_start.py:92
msgid "Open Printer Settings"
msgstr ""

#: src/ubuntu_start.py:93
msgid "Connect the printer"
msgstr ""

#: src/ubuntu_start.py:93
msgid ""
"Turn it on and connect it to the same network as your computer, or connect "
"it with USB."
msgstr ""

#: src/ubuntu_start.py:94
msgid ""
"Open Printers in Settings, select Add Printer and choose the printer Ubuntu "
"finds."
msgstr ""

#: src/ubuntu_start.py:95
msgid "Print a test page"
msgstr ""

#: src/ubuntu_start.py:95
msgid ""
"Follow the prompts, then print a test page. Install a model-specific driver "
"only when Ubuntu or the manufacturer recommends it."
msgstr ""

#: src/ubuntu_start.py:97
msgid "Make text easier to read"
msgstr ""

#: src/ubuntu_start.py:97 src/ubuntu_start.py:102 src/ubuntu_start.py:107
msgid "Open Accessibility Settings"
msgstr ""

#: src/ubuntu_start.py:98
msgid "Open Accessibility settings"
msgstr ""

#: src/ubuntu_start.py:98
msgid "In Settings, choose Accessibility and open the Seeing section."
msgstr ""

#: src/ubuntu_start.py:99
msgid "Turn on Large Text"
msgstr ""

#: src/ubuntu_start.py:99
msgid ""
"Switch on Large Text. You can also try the accessibility menu in the top bar "
"for a quick toggle."
msgstr ""

#: src/ubuntu_start.py:100
msgid "Adjust other display options"
msgstr ""

#: src/ubuntu_start.py:100
msgid ""
"Try High Contrast or a different cursor size if those make the screen easier "
"for you to use."
msgstr ""

#: src/ubuntu_start.py:102
msgid "Magnify part of the screen"
msgstr ""

#: src/ubuntu_start.py:103
msgid "Open the Zoom section"
msgstr ""

#: src/ubuntu_start.py:103
msgid "In Settings, choose Accessibility, then open Zoom."
msgstr ""

#: src/ubuntu_start.py:104
msgid "Turn on Desktop Zoom"
msgstr ""

#: src/ubuntu_start.py:104
msgid ""
"Switch on Desktop Zoom and move the pointer to the screen edge to explore "
"the magnified area."
msgstr ""

#: src/ubuntu_start.py:105
msgid "Tune the magnifier"
msgstr ""

#: src/ubuntu_start.py:105
msgid ""
"Adjust magnification and pointer tracking until the view feels comfortable. "
"Turn Zoom off in the same section."
msgstr ""

#: src/ubuntu_start.py:107
msgid "Use the screen reader"
msgstr ""

#: src/ubuntu_start.py:108
msgid "Open the Seeing section"
msgstr ""

#: src/ubuntu_start.py:108
msgid "In Settings, choose Accessibility and look for Screen Reader."
msgstr ""

#: src/ubuntu_start.py:109
msgid "Turn on the screen reader"
msgstr ""

#: src/ubuntu_start.py:109
msgid ""
"Enable Orca and follow its welcome prompts. Connect a refreshable Braille "
"display first if you use one."
msgstr ""

#: src/ubuntu_start.py:110
msgid "Learn the keyboard shortcuts"
msgstr ""

#: src/ubuntu_start.py:110
msgid ""
"Use Orca’s help and keyboard shortcuts to navigate and adjust speech "
"preferences."
msgstr ""

#: src/ubuntu_start.py:112
msgid "Install Ubuntu updates"
msgstr ""

#: src/ubuntu_start.py:112 src/ubuntu_start.py:113
msgid "Open Software Updater"
msgstr ""

#: src/ubuntu_start.py:113
msgid ""
"Ubuntu checks for updates when Software Updater opens. Select Check if it "
"does not start checking."
msgstr ""

#: src/ubuntu_start.py:114
msgid "Review available updates"
msgstr ""

#: src/ubuntu_start.py:114
msgid ""
"Read the update summary. Save your work before installing system updates."
msgstr ""

#: src/ubuntu_start.py:115
msgid "Install and restart if asked"
msgstr ""

#: src/ubuntu_start.py:115
msgid ""
"Select Install Now and enter your password if prompted. Restart only when "
"Ubuntu asks you to."
msgstr ""

#: src/ubuntu_start.py:117
msgid "Use the Terminal"
msgstr ""

#: src/ubuntu_start.py:117 src/ubuntu_start.py:728
msgid "Open Terminal"
msgstr ""

#: src/ubuntu_start.py:118
msgid "What the prompt means"
msgstr ""

#: src/ubuntu_start.py:118
msgid ""
"The prompt is the text before the cursor. It shows that the terminal is "
"ready for a command. Type after it; do not type the prompt itself."
msgstr ""

#: src/ubuntu_start.py:119
msgid "Run a command"
msgstr ""

#: src/ubuntu_start.py:119
msgid ""
"Type a command and press Enter to run it. For example, pwd shows the current "
"folder and ls lists its files. These commands only show information."
msgstr ""

#: src/ubuntu_start.py:120
msgid "Read the result"
msgstr ""

#: src/ubuntu_start.py:120
msgid ""
"Commands may print information or an error message. Read the last lines "
"first. If a command finishes without an error, it may return to the prompt "
"without printing anything."
msgstr ""

#: src/ubuntu_start.py:121
msgid "Move between folders"
msgstr ""

#: src/ubuntu_start.py:121
msgid ""
"Use cd Documents to enter a folder and cd .. to go up one level. Use pwd to "
"check where you are."
msgstr ""

#: src/ubuntu_start.py:122
msgid "Use Tab and command history"
msgstr ""

#: src/ubuntu_start.py:122
msgid ""
"Press Tab to complete a file or folder name when it is unique. Press the Up "
"Arrow to find a command you used earlier; check it before pressing Enter."
msgstr ""

#: src/ubuntu_start.py:123
msgid "Type paths with spaces"
msgstr ""

#: src/ubuntu_start.py:123
msgid ""
"Put quotation marks around a folder or file name that contains spaces, for "
"example: cd \"My Documents\". You can also type the first letters and press "
"Tab to complete the name."
msgstr ""

#: src/ubuntu_start.py:124
msgid "Ask a command for help"
msgstr ""

#: src/ubuntu_start.py:124
msgid ""
"Try a command followed by --help, such as ls --help. For more detail, use "
"man followed by the command name; press q to leave the manual."
msgstr ""

#: src/ubuntu_start.py:125
msgid "Understand sudo"
msgstr ""

#: src/ubuntu_start.py:125
msgid ""
"sudo runs a command with administrator privileges. Use it only when you "
"understand and trust the command. Your password is not shown while you type "
"it."
msgstr ""

#: src/ubuntu_start.py:126
msgid "Stop a running command"
msgstr ""

#: src/ubuntu_start.py:126
msgid ""
"Ctrl+C asks the current command to stop. It does not undo changes the "
"command has already made."
msgstr ""

#: src/ubuntu_start.py:127
msgid "Keep commands from trusted sources"
msgstr ""

#: src/ubuntu_start.py:127
msgid ""
"Do not paste commands you do not understand, especially commands using sudo, "
"rm, disk tools or scripts downloaded from the internet."
msgstr ""

