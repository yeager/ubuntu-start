msgid "Drivers"
msgstr ""

#: src/ubuntu_start.py:226 src/ubuntu_start.py:919
msgid "Help and support"
msgstr ""

#: src/ubuntu_start.py:269
msgid "A calmer start with Ubuntu"
msgstr ""

#: src/ubuntu_start.py:269
msgid ""
"Set up the essentials, then find clear steps when a device does not work."
msgstr ""

#: src/ubuntu_start.py:270
msgid "Your computer, at a glance"
msgstr ""

#: src/ubuntu_start.py:270
msgid ""
"Use Settings to check your Ubuntu version, storage and connected devices."
msgstr ""

#: src/ubuntu_start.py:270 src/ubuntu_start.py:284
msgid "Open Settings"
