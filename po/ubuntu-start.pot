#: src/ubuntu_start.py:233 src/ubuntu_start.py:247
msgid "Open Settings"
msgstr ""

#: src/ubuntu_start.py:234
msgid "Take it one step at a time"
msgstr ""

#: src/ubuntu_start.py:234
msgid "You can come back to any guide whenever you need it."
msgstr ""

#: src/ubuntu_start.py:238
msgid ""
"A few useful places to begin. Ubuntu may ask for your password when you "
"change system settings."
msgstr ""

#: src/ubuntu_start.py:240
msgid "Language and keyboard"
msgstr ""

#: src/ubuntu_start.py:240
msgid "Choose your display language, region and keyboard layout."
msgstr ""

#: src/ubuntu_start.py:241
msgid "Internet connection"
msgstr ""

#: src/ubuntu_start.py:241
msgid "Connect to Wi-Fi or a wired network."
msgstr ""

#: src/ubuntu_start.py:242
msgid "Updates"
msgstr ""

#: src/ubuntu_start.py:242
msgid "Check for system updates and restart if Ubuntu asks you to."
msgstr ""

#: src/ubuntu_start.py:243
msgid "Sound and display"
msgstr ""

#: src/ubuntu_start.py:243
msgid "Choose speakers, microphone and monitor settings."
msgstr ""

#: src/ubuntu_start.py:244
msgid "Privacy and screen lock"
msgstr ""

#: src/ubuntu_start.py:244
msgid "Review app permissions and automatic screen locking."
msgstr ""

#: src/ubuntu_start.py:245
msgid "Accessibility"
msgstr ""

#: src/ubuntu_start.py:245
msgid "Adjust text size, magnification, screen reader and keyboard access."
msgstr ""

#: src/ubuntu_start.py:263
msgid "Open Ubuntu App Center?"
msgstr ""

#: src/ubuntu_start.py:264
msgid ""
"The App Center may contact your configured software sources to show apps and "
"updates. Ubuntu Start will not install anything. You can review app details "
"and choose whether to install in the App Center."
msgstr ""

#: src/ubuntu_start.py:266 src/ubuntu_start.py:552 src/ubuntu_start.py:576
#: src/ubuntu_start.py:623
msgid "Cancel"
msgstr ""

#: src/ubuntu_start.py:267
msgid "Open App Center"
msgstr ""

#: src/ubuntu_start.py:278
msgid "No supported software center was found."
msgstr ""

#: src/ubuntu_start.py:288
msgid "No supported terminal application was found."
msgstr ""

#: src/ubuntu_start.py:293
msgid ""
"Choose a device or search all guides for a symptom. These checks do not "
"install software or change system files."
msgstr ""

#: src/ubuntu_start.py:296
msgid "Search all guides and steps"
msgstr ""

#: src/ubuntu_start.py:305
msgid "Suggested checks"
msgstr ""

#: src/ubuntu_start.py:311
msgid "WiFi Analyzer"
msgstr ""

#: src/ubuntu_start.py:312
msgid ""
"See nearby Wi-Fi signal levels and channel use to investigate weak signal or "
"crowded channels."
msgstr ""

#: src/ubuntu_start.py:314
msgid "View on GitHub"
msgstr ""

#: src/ubuntu_start.py:317
msgid "Open WiFi Analyzer on GitHub?"
msgstr ""

#: src/ubuntu_start.py:318
msgid ""
"This opens the project page in your browser. GitHub will receive a normal "
"web request and can see your IP address."
msgstr ""

#: src/ubuntu_start.py:330
msgid "No matching steps. Try another word."
msgstr ""

#: src/ubuntu_start.py:347
msgid "Open related Settings"
msgstr ""

#: src/ubuntu_start.py:366
msgid "Show this guide"
msgstr ""

