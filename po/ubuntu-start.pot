msgstr ""

#: src/ubuntu_start.py:428
msgid "Storage is almost full"
msgstr ""

#: src/ubuntu_start.py:428
msgid ""
"Remove files you no longer need or review large downloads. Avoid deleting "
"system files."
msgstr ""

#: src/ubuntu_start.py:433
msgid "Battery"
msgstr ""

#: src/ubuntu_start.py:434
msgid ""
"Charge level and charging state come from local system information. An "
"estimated capacity compared with the original design is shown only if the "
"battery exposes both values."
msgstr ""

#: src/ubuntu_start.py:437
msgid "Charging"
msgstr ""

#: src/ubuntu_start.py:438
msgid "Discharging"
msgstr ""

#: src/ubuntu_start.py:439
msgid "Full"
msgstr ""

