msgstr "{pixels} pixlar"

#: src/ubuntu_start.py:1405
msgid "Pointer size"
msgstr "Pekarstorlek"

#: src/ubuntu_start.py:1408
msgid "GNOME Settings tools are not installed."
msgstr "gsettings är inte installerat."

#: src/ubuntu_start.py:1409
msgid "Could not read GNOME accessibility settings."
msgstr "Det gick inte att läsa GNOME:s tillgänglighetsinställningar."

#: src/ubuntu_start.py:1411
msgid "GNOME accessibility settings read. No settings were changed."
msgstr ""
"GNOME:s tillgänglighetsinställningar har lästs. Inga inställningar har "
"ändrats."

#: src/ubuntu_start.py:1420
msgid "Ready"
msgstr "Redo"

#: src/ubuntu_start.py:1421
msgid "Printing"
msgstr "Skriver ut"

#: src/ubuntu_start.py:1422
msgid "Disabled"
msgstr "Inaktiverad"

#: src/ubuntu_start.py:1423 src/ubuntu_start.py:1424
msgid "Busy"
msgstr "Upptagen"

#: src/ubuntu_start.py:1425
msgid "Stopped"
msgstr "Stoppad"

#: src/ubuntu_start.py:1429
msgid "Status unknown"
msgstr "Okänd status"

#: src/ubuntu_start.py:1430
