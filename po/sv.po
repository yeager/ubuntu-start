#: src/ubuntu_start.py:1677
msgid "NetworkManager did not respond in time. Try refreshing again."
msgstr "NetworkManager svarade inte i tid. Försök uppdatera statusen igen."

#: src/ubuntu_start.py:1678
msgid "Could not read device status from NetworkManager."
msgstr "Det gick inte att läsa enhetsstatus från NetworkManager."

#: src/ubuntu_start.py:1687
msgid "NetworkManager reported no network devices."
msgstr "NetworkManager rapporterade inga nätverksenheter."

#: src/ubuntu_start.py:1693
msgid "This is local device status; internet access has not been tested."
msgstr "Det här är en lokal enhetsstatus. Internetåtkomsten har inte testats."

#: src/ubuntu_start.py:1697
msgid "Wired"
msgstr "Trådbundet"

#: src/ubuntu_start.py:1698
msgid "Mobile broadband"
msgstr "Mobilt bredband"

#: src/ubuntu_start.py:1699
msgid "Bridge"
msgstr "Brygga"

#: src/ubuntu_start.py:1700
msgid "VPN"
msgstr "VPN"

#: src/ubuntu_start.py:1703
msgid "Connected"
msgstr "Ansluten"

#: src/ubuntu_start.py:1704
msgid "Disconnected"
msgstr "Frånkopplad"

#: src/ubuntu_start.py:1705
msgid "Connecting"
msgstr "Ansluter"

#: src/ubuntu_start.py:1707
msgid "Not managed by NetworkManager"
msgstr "Hanteras inte av NetworkManager"

#: src/ubuntu_start.py:1708
msgid "Unavailable (missing firmware)"
msgstr "Inte tillgänglig (fast programvara saknas)"

#: src/ubuntu_start.py:1717
